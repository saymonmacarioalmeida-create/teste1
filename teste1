        alternarMenu()
    elseif i.KeyCode == Enum.KeyCode.H then
        Config.Ligado = not Config.Ligado
        toggleAim.Set(Config.Ligado)
        notificar("Aim Lock", Config.Ligado and "LIGADO" or "DESLIGADO", 1.5)
    end
end)

