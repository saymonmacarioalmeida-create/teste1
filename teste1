local sombraOriginal = Lighting.GlobalShadows
local qualidadeOriginal
pcall(function() qualidadeOriginal = settings().Rendering.QualityLevel end)

local function antiLagSombras(ligar)
    if ligar then
        sombraOriginal = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    else
        Lighting.GlobalShadows = sombraOriginal
    end
end

local function antiLagQualidade(ligar)
    pcall(function()
        if ligar then
            qualidadeOriginal = settings().Rendering.QualityLevel
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
        elseif qualidadeOriginal then
            settings().Rendering.QualityLevel = qualidadeOriginal
        end
    end)
end

