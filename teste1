        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = T.Ciano,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
    }, conteudo)
    criar("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, pagina)
    criar("UIPadding", {
        PaddingTop = UDim.new(0, 2),
        PaddingRight = UDim.new(0, 8),
        PaddingBottom = UDim.new(0, 6),
    }, pagina)

    aba.botao, aba.marca, aba.rotulo, aba.pagina = botao, marca, rotuloAba, pagina

    local function selecionar()
        if abaAtiva == aba then return end
        if abaAtiva then
            abaAtiva.pagina.Visible = false
            tw(abaAtiva.marca, 0.2, { BackgroundTransparency = 1 })
            tw(abaAtiva.botao, 0.2, { BackgroundTransparency = 1 })
            tw(abaAtiva.rotulo, 0.2, { TextColor3 = T.Dim })
        end
        abaAtiva = aba
        pagina.Visible = true
        tw(marca, 0.2, { BackgroundTransparency = 0 })
        tw(botao, 0.2, { BackgroundTransparency = 0.88 })
        tw(rotuloAba, 0.2, { TextColor3 = T.Texto })
    end
    botao.MouseButton1Click:Connect(selecionar)
    aba.selecionar = selecionar

    local ordemEl = 0
    local function caixa(altura)
        ordemEl += 1
        local f = criar("Frame", {
            Size = UDim2.new(1, 0, 0, altura),
            BackgroundColor3 = T.Elemento,
            BorderSizePixel = 0,
            LayoutOrder = ordemEl,
        }, pagina)
        cantos(f, 8)
        local s = borda(f, T.Ciano, 0.85)
        f.MouseEnter:Connect(function()
            tw(f, 0.15, { BackgroundColor3 = T.Hover })
            tw(s, 0.15, { Transparency = 0.5 })
        end)
        f.MouseLeave:Connect(function()
            tw(f, 0.15, { BackgroundColor3 = T.Elemento })
            tw(s, 0.15, { Transparency = 0.85 })
        end)
        return f
    end

    function aba:Secao(nome)
        ordemEl += 1
        local l = texto(pagina, {
            Size = UDim2.new(1, 0, 0, 20),
            Text = "// " .. string.upper(nome),
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = T.Ciano,
            LayoutOrder = ordemEl,
        })
        return l
    end

    function aba:Toggle(nome, inicial, cb)
        local f = caixa(38)
        texto(f, {
            Position = UDim2.fromOffset(12, 0),
            Size = UDim2.new(1, -70, 1, 0),
            Text = nome,
        })
        local sw = criar("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(40, 20),
            BackgroundColor3 = T.Off,
            BorderSizePixel = 0,
        }, f)
        cantos(sw, 10)
        local knob = criar("Frame", {
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 3, 0.5, 0),
            Size = UDim2.fromOffset(14, 14),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
        }, sw)
        cantos(knob, 7)

        local estado = inicial and true or false
        local function aplicar(animar)
            local t = animar and 0.18 or 0
            tw(sw, t, { BackgroundColor3 = estado and T.Ciano or T.Off })
            tw(knob, t, { Position = estado and UDim2.new(1, -17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
        end
        aplicar(false)

        local clique = criar("TextButton", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
        }, f)
        clique.MouseButton1Click:Connect(function()
            estado = not estado
            aplicar(true)
            cb(estado)
        end)

        return {
            Set = function(v)
                estado = v and true or false
                aplicar(true)
            end,
        }
    end

    function aba:Slider(nome, minimo, maximo, incremento, inicial, sufixo, cb)
        local f = caixa(54)
        texto(f, {
            Position = UDim2.fromOffset(12, 4),
            Size = UDim2.new(1, -110, 0, 24),
            Text = nome,
        })
        local valorLabel = texto(f, {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -12, 0, 4),
            Size = UDim2.fromOffset(100, 24),
            TextXAlignment = Enum.TextXAlignment.Right,
            Font = Enum.Font.Code,
            TextSize = 12,
            TextColor3 = T.Ciano,
            Text = "",
        })

        local trilho = criar("Frame", {
            Position = UDim2.new(0, 12, 0, 36),
            Size = UDim2.new(1, -24, 0, 6),
            BackgroundColor3 = T.Off,
            BorderSizePixel = 0,
        }, f)
        cantos(trilho, 3)
        local preenche = criar("Frame", {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
        }, trilho)
        cantos(preenche, 3)
        neon(preenche, 0)
        local bola = criar("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
        }, trilho)
        cantos(bola, 6)
        borda(bola, T.Ciano, 0.2, 2)

        local valor = inicial
        local function mostrar()
            local frac = (valor - minimo) / (maximo - minimo)
            preenche.Size = UDim2.fromScale(frac, 1)
            bola.Position = UDim2.fromScale(frac, 0.5)
            valorLabel.Text = tostring(math.floor(valor * 100 + 0.5) / 100) .. (sufixo or "")
        end
        mostrar()

        local zona = criar("TextButton", {
            Position = UDim2.fromOffset(0, 26),
            Size = UDim2.new(1, 0, 0, 26),
            BackgroundTransparency = 1,
            Text = "",
        }, f)
        arrastavel(zona, function(x)
            local frac = math.clamp((x - trilho.AbsolutePosition.X) / math.max(trilho.AbsoluteSize.X, 1), 0, 1)
            local v = minimo + frac * (maximo - minimo)
            v = math.floor(v / incremento + 0.5) * incremento
            v = math.clamp(v, minimo, maximo)
            if v ~= valor then
                valor = v
                mostrar()
                cb(valor)
            end
        end)
    end

    function aba:Cor(nome, inicial, lista, cb)
        local f = caixa(86)
        texto(f, {
            Position = UDim2.fromOffset(12, 4),
            Size = UDim2.new(1, -60, 0, 24),
            Text = nome,
        })
        local previa = criar("Frame", {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -12, 0, 9),
            Size = UDim2.fromOffset(34, 14),
            BackgroundColor3 = inicial,
            BorderSizePixel = 0,
        }, f)
        cantos(previa, 4)
        borda(previa, Color3.new(1, 1, 1), 0.6)

        local function aplicar(cor)
            previa.BackgroundColor3 = cor
            cb(cor)
        end

        local fila = criar("Frame", {
            Position = UDim2.fromOffset(12, 32),
            Size = UDim2.new(1, -24, 0, 20),
            BackgroundTransparency = 1,
        }, f)
        criar("UIListLayout", {
            FillDirection = Enum.FillDirection.Horizontal,
            Padding = UDim.new(0, 5),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, fila)
        for i, cor in ipairs(lista) do
            local b = criar("TextButton", {
                Size = UDim2.fromOffset(30, 20),
                BackgroundColor3 = cor,
                Text = "",
                AutoButtonColor = false,
                LayoutOrder = i,
            }, fila)
            cantos(b, 5)
            borda(b, Color3.new(1, 1, 1), 0.75)
            b.MouseButton1Click:Connect(function() aplicar(cor) end)
        end

        local hue = criar("Frame", {
            Position = UDim2.new(0, 12, 0, 62),
            Size = UDim2.new(1, -24, 0, 10),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
        }, f)
        cantos(hue, 5)
        criar("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
                ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
                ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
                ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
                ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
                ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
                ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
            }),
        }, hue)
        local bolaHue = criar("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(6, 16),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BorderSizePixel = 0,
            Visible = false,
        }, hue)
        cantos(bolaHue, 3)

        local zona = criar("TextButton", {
            Position = UDim2.fromOffset(0, 56),
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            Text = "",
        }, f)
        arrastavel(zona, function(x)
            local frac = math.clamp((x - hue.AbsolutePosition.X) / math.max(hue.AbsoluteSize.X, 1), 0, 1)
            bolaHue.Visible = true
            bolaHue.Position = UDim2.fromScale(frac, 0.5)
            aplicar(Color3.fromHSV(frac, 1, 1))
        end)
    end

    if not abaAtiva then selecionar() end
    return aba
end

